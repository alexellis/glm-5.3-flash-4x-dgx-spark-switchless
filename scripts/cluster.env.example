# Copy to scripts/cluster.env and edit for your site. This file contains no
# credentials; keep the real inventory local if you do not want it in Git.
SSH_USER=you

NODE0=10.0.0.1
NODE1=10.0.0.2
NODE2=10.0.0.3
NODE3=10.0.0.4
NODE0_NAME=node0
NODE1_NAME=node1
NODE2_NAME=node2
NODE3_NAME=node3

REMOTE_LAUNCHER=/home/you/glm53-tp4-switchless-recipe/scripts/rank-launcher.sh
REMOTE_TEMPLATE=/home/you/glm53-chat-template-zai-20260904.jinja
EXPECTED_LAUNCHER_SHA256=
EXPECTED_TEMPLATE_SHA256=0c4099f3382d6c92700dfb99725025360966fd73032f0ecf32377c0d9e6309c5
# Canonical switchless-nccl v0.0.1 release. cluster-up verifies this exact
# published library on every rank before launch.
REMOTE_NCCL_DIR=/home/you/nccl-switchless-v0.0.1
EXPECTED_NCCL_SHA256=78cb83871792ec57d763d142e4cae26fc754ae284bcc81dcb2a7d50e17d4fa57
CONTAINER_NAME=glm53_tp4
HEAD_URL=http://10.0.0.1:8000

# Run the fabric script locally by default. Set FABRIC_HOST to run a
# site-specific command on a node which can reach the other three nodes.
FABRIC_HOST=
FABRIC_COMMAND=./scripts/fabric-setup.sh

# Optional supervised stacks to stop before any Docker churn. Values are
# space-separated systemd unit names. They are not restarted by cluster-up.
STOP_UNITS_NODE0=
STOP_UNITS_NODE1=
STOP_UNITS_NODE2=
STOP_UNITS_NODE3=

# Optional default stacks for: cluster-down.sh --restore-defaults
RESTORE_UNITS_NODE0=
RESTORE_UNITS_NODE1=
RESTORE_UNITS_NODE2=
RESTORE_UNITS_NODE3=

COLLECTIVE_TIMEOUT=90
STARTUP_TIMEOUT=900
