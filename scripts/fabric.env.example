# Copy to scripts/fabric.env and edit for your site. The file is gitignored
# because it contains your private endpoints and cabling (see .gitignore).
#
# fabric-setup.sh sources this file after its own defaults, so any value here
# overrides the placeholder in the script body. Leave a value commented out
# to keep the script default.

SSH_USER="you"

# Management IPs of the four nodes (rank order). Used only to SSH in.
# Rank order must follow the physical cable order — see docs/fabric.md.
NODE0_IP="10.0.0.1"     # rank 0 / head
NODE1_IP="10.0.0.2"     # rank 1
NODE2_IP="10.0.0.3"     # rank 2
NODE3_IP="10.0.0.4"     # rank 3

# Ring addresses applied to the nodes' rails (pair rail F1, cross rail F0).
# The values below mirror the template defaults in fabric-setup.sh: four
# point-to-point /24 edges on 10.10.10/20/30/40, last octet = rank + 1.
# Replace them with your own addresses and topology.
NODE0_F1="10.10.10.1"; NODE0_F0="10.10.40.1"
NODE1_F1="10.10.10.2"; NODE1_F0="10.10.20.2"
NODE2_F1="10.10.30.3"; NODE2_F0="10.10.20.3"
NODE3_F1="10.10.30.4"; NODE3_F0="10.10.40.4"

# Point-to-point edges to jumbo-ping: "<source management IP> <peer fabric IP>".
# This is the default in fabric-setup.sh, covering the template ring above;
# uncomment and edit it if your cables pair different ports on some nodes.
#
# JUMBO_EDGES=(
#   "$NODE0_IP $NODE1_F1"   # pair edge   node0 <-> node1 (10.10.10.0/24)
#   "$NODE1_IP $NODE2_F0"   # cross edge  node1 <-> node2 (10.10.20.0/24)
#   "$NODE2_IP $NODE3_F1"   # pair edge   node2 <-> node3 (10.10.30.0/24)
#   "$NODE3_IP $NODE0_F0"   # cross edge  node3 <-> node0 (10.10.40.0/24)
# )
